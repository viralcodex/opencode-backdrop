{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-backdrop",
  "version": "0.2.0",
  "description": "Use your own local wallpapers in OpenCode Desktop",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viralcodex/opencode-backdrop.git"
  },
  "homepage": "https://github.com/viralcodex/opencode-backdrop#readme",
  "bugs": {
    "url": "https://github.com/viralcodex/opencode-backdrop/issues"
  },
  "packageManager": "bun@1.4.4",
  "keywords": ["opencode", "plugin", "desktop", "wallpaper", "background"],
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "index.ts",
    "dist/gui-experimental.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:gui": "bun --bun vite build",
    "check": "bun run typecheck && bun run build:gui && bun run test && bun run test:node && bun run check:package",
    "check:package": "bun script/check-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser src",
    "test:styles": "bun script/check-styles.ts",
    "test:node": "bun script/check-catalog-node.ts",
    "test:storage": "bun script/check-preferences.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "~2.2.6 || ~2.3.2 || ^0.0.0-dev",
    "effect": "^4.1.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.6",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "4.1.0",
    "playwright-core": "1.65.1",
    "solid-js": "1.9.17",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  }
}
